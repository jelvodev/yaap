 const THOUSANDS = /\B(?=(\d{3})+(?!\d))/g;
 
-/** 123456 -> "€1,234.56". */
+/** 123456 -> "€1,234.56"; a negative amount has its minus sign first: -500 -> "-€5.00" (WEB-4). */
 export function formatMoney(cents: number): string {
   if (!Number.isInteger(cents)) {
     throw new Error(`formatMoney expects whole cents, got ${cents}`);
   }
-  const euros = Math.trunc(cents / 100);
-  const rest = Math.abs(cents % 100);
-  return `€${String(euros).replace(THOUSANDS, ",")}.${String(rest).padStart(2, "0")}`;
+  const sign = cents < 0 ? "-" : "";
+  const euros = Math.floor(Math.abs(cents) / 100);
+  const rest = Math.abs(cents) % 100;
+  return `${sign}€${String(euros).replace(THOUSANDS, ",")}.${String(rest).padStart(2, "0")}`;
 }
 
 /** 1 -> "1 item", 3 -> "3 items". */
