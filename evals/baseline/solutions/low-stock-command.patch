diff --git a/stockroom/report.py b/stockroom/report.py
index ff11e6c..5cc6598 100644
--- a/stockroom/report.py
+++ b/stockroom/report.py
@@ -93,6 +93,22 @@ def restock_report(inventory: Inventory) -> str:
     return "\n".join(lines) + "\n"
 
 
+def low_stock_report(inventory: Inventory) -> str:
+    """Items whose available units are at or below their reorder level, most missing first."""
+    low = sorted(
+        inventory.needs_reorder(), key=lambda item: (-(item.reorder_level - item.available), item.sku)
+    )
+    if not low:
+        return "Nothing is low on stock.\n"
+    lines = [f"{'SKU':<9} {'Name':<{NAME_WIDTH}} {'Avail':>6} {'Level':>6} {'Short':>6}"]
+    for item in low:
+        short = item.reorder_level - item.available
+        lines.append(
+            f"{item.sku:<9} {short_name(item.name):<{NAME_WIDTH}} {item.available:>6} {item.reorder_level:>6} {short:>6}"
+        )
+    return "\n".join(lines) + "\n"
+
+
 def format_legacy_row(item: Item) -> str:
     """The semicolon format of the old spreadsheet, for a one-off migration."""
     return ";".join([item.sku, item.name, str(item.quantity), str(item.unit_cost_cents)])
