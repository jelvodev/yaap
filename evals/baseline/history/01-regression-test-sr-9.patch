+    def test_reservation_times_keep_their_timezone_after_a_round_trip(self) -> None:
+        # SR-9: after a restart the CLI crashed when it expired reservations read from the file.
+        clock = Clock()
+        inventory = make_inventory(clock)
+        reservation = inventory.reserve("SR-1", 2, hours=5)
+        storage.save(inventory, self.path)
+        loaded = storage.load(self.path, Inventory(clock=clock))
+        self.assertEqual(loaded.reservation(reservation.id).expires_at, reservation.expires_at)
+        clock.advance(hours=6)
+        self.assertEqual([r.id for r in loaded.expire_reservations()], [reservation.id])
+        self.assertEqual(loaded.movements(), inventory.movements())
+
