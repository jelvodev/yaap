# Copy this file to .env and fill in the values. Never commit .env.

# Encrypts the API keys stored in YAAP. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a copy outside the data folder: without it, stored keys cannot be read and must be entered again.
YAAP_MASTER_KEY=

# Instead of YAAP_MASTER_KEY: a file inside the container that holds the key, for example a Docker secret at
# /run/secrets/yaap_master_key (see docs/configuration.md). Leave empty to use YAAP_MASTER_KEY.
YAAP_MASTER_KEY_FILE=

# Only while changing the master key: the old key. YAAP re-encrypts everything with the new key on start; remove
# this line when Settings › Vault says no value needs the old key any more.
YAAP_MASTER_KEY_PREVIOUS=

# Extra host names YAAP answers on besides localhost, 127.0.0.1 and [::1], separated by commas or spaces, for
# example yaap.lan (docs/configuration.md). Leave empty for the default; it does not make YAAP safe on a network.
YAAP_ALLOWED_HOSTS=

# The port of the preview beside the chat, where a dev server the agent started is shown (docs/configuration.md).
# Like YAAP's own port it is only reachable from this computer. 0 switches the preview off (then also remove its line
# under ports in docker-compose.override.yml, see docs/configuration.md).
YAAP_PREVIEW_PORT=8081

# Host folder for the database and other application data. Defaults to ./data.
YAAP_DATA_HOST=./data

# CPUs and memory of each environment's runner and each project's sandbox container (docs/install.md).
# YAAP_SANDBOX_CPUS=2
# YAAP_SANDBOX_MEMORY=4g

# Where docker-compose.yml pulls YAAP's images from. Leave it unset for the published
# images (ghcr.io/jelvodev). A fork that publishes its own images sets its own prefix.
# YAAP_IMAGE_PREFIX=ghcr.io/jelvodev

# Build the images from this folder instead of pulling the published ones.
# scripts/setup.sh --build (scripts\setup.ps1 -Build) writes these two lines for you.
# COMPOSE_PATH_SEPARATOR makes the same list work on Windows, where Compose otherwise splits on ";".
# Add docker-compose.override.yml to the list when you have one: Compose reads it by itself
# only while COMPOSE_FILE is not set. With these lines the update script builds the new
# version instead of pulling it; remove both to go back to the published images.
# See "Building the images yourself" in docs/install.md.
# COMPOSE_PATH_SEPARATOR=,
# COMPOSE_FILE=docker-compose.yml,docker-compose.build.yml
