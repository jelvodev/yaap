    {
      "name": "delegate",
      "description": "Hand a self-contained task to a sub-run, on the cheaper worker model unless you name an agent or role main. It does not see this conversation: give the goal, files, constraints and how to check. mode explore only reads and searches and reports files, lines and a conclusion: use it to find things out without filling your context. Otherwise it works with your tools; keep planning and decisions yourself and check its changes.",
      "input_schema": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "work",
              "explore"
            ],
            "description": "Default work."
          },
          "agent": {
            "type": "string",
            "description": "Optional agent definition, by name."
          },
          "role": {
            "type": "string",
            "enum": [
              "worker",
              "main"
            ],
            "description": "Default worker."
          },
          "worker": {
            "type": "string",
            "description": "Optional: a preset by name (its worker model), claude_code or codex (CLIs on the user's subscription). Default: this conversation's worker model."
          }
        },
        "required": [
          "task"
        ],
        "additionalProperties": false
      },
      "permission": "auto",
      "scope": "project",
      "read_only": false,
      "asks_itself": false,
      "takes_secrets": false,
      "describes": false,
      "conditional": false
    },
