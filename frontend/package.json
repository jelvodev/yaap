{
  "name": "yaap-frontend",
  "private": true,
  "version": "0.5.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run check:sdk && vite build",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "gen:sdk": "node plugin-sdk/generate.mjs openapi.json plugin-sdk/.build",
    "check:sdk": "npm run gen:sdk && tsc -p plugin-sdk/tsconfig.json",
    "test:sdk": "node --test plugin-sdk/",
    "test:unit": "node --test \"src/**/*.test.mjs\""
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "1.2.5",
    "codemirror": "6.0.2",
    "fflate": "0.8.3",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
